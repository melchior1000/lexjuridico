# Exemplo sem credenciais. Configurar somente em homologacao separada.
# O programa nao carrega este arquivo automaticamente.
PORT=3000
SUPABASE_URL=
SUPABASE_KEY=
# Tenant do escritório atual. Obrigatório antes de ativar LEX_TENANCY_REQUIRED=1.
LEX_ESCRITORIO_ID=
# 0 durante migração; 1 em produção depois que todas as tabelas tenant-aware estiverem backfilled.
LEX_TENANCY_REQUIRED=0
# Banco do runtime: rest (legado Supabase Data API) ou postgres (RLS real).
LEX_DB_MODE=rest
# Em postgres, usar SOMENTE a string do Supavisor Session Pooler (porta 5432)
# ou conexão direta compatível. A role deve ser lex_runtime, sem BYPASSRLS.
LEX_DATABASE_URL=
# Segredo que assina as sessões (mínimo 32 bytes aleatórios; ex.: openssl rand -hex 32).
# OBRIGATÓRIO em produção: sem ele, cada reinício derruba todos os logins.
AUTH_SECRET=
SENHA_ADMIN=
SENHA_SECRETARIA=
IA_PROVIDER=anthropic
ANTHROPIC_KEY=
LEX_ANTHROPIC_MODEL_TOP=claude-opus-5
LEX_ANTHROPIC_LEGAL_MODEL=claude-fable-5-1
# Conversa no WhatsApp/Telegram (chat, recepção de clientes) e respostas curtas.
# Mais baratos; peça, análise, perícia e prazo continuam nos modelos acima.
LEX_ANTHROPIC_MODEL_CANAL=claude-sonnet-5
LEX_ANTHROPIC_MODEL_RAPIDO=claude-haiku-4-5
# Todos os tiers Anthropic usam TOP; MID/ECO legados são ignorados.
LEX_AI_MAX_CONCURRENT=2
LEX_AI_MAX_TOOL_LOOPS=3
# Provedores auxiliares opcionais; nenhuma chamada e contratacao automatica.
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Integracoes opcionais: usar somente contas/numeros de teste em homologacao.
TELEGRAM_TOKEN=
TELEGRAM_ADMIN=
# Linha do LEX no formato 55 + DDD + celular (nao ativa o WhatsApp sozinha).
LEX_WHATSAPP_NUMBER=
EVOLUTION_URL=
EVOLUTION_KEY=
EVOLUTION_INSTANCE=
# Configurar também como x-webhook-secret na Evolution antes de ativar o canal.
WHATSAPP_WEBHOOK_SECRET=
LEX_SMTP_HOST=
LEX_SMTP_PORT=587
LEX_SMTP_USER=
LEX_SMTP_PASS=
# Limite global legado; politica por rota ainda pendente. Ajustar apos ensaio.
LEX_MAX_BODY_MB=25

# Chave pública vigente: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# Consulta pública de metadados; não substitui login PJe nem acesso a documentos.
DATAJUD_API_KEY=

# Segredo do servidor para assinar evidências de leitura judicial (mínimo 32 bytes). Nunca versionar o valor real.
COURT_READING_INTEGRITY_KEY=

# DJEN: o backend Render deve apontar para o gateway Vercel em gru1.
# Ex.: https://<dominio-vercel>/api/djen
DJEN_BASE=
DJEN_GATEWAY_KEY=
# Lista explícita de inscrições monitoradas: numero:UF,numero:UF
DJEN_OABS=

# ── Identidade do escritório (white-label) — nada disso fica no código ──
ESCRITORIO_NOME=
ESCRITORIO_RESP=
ESCRITORIO_REG=
ESCRITORIO_END=
# Forma de tratamento do titular (padrão "Dr(a).")
LEX_TITULAR_TRATAMENTO=
LEX_ASSISTENTE_NOME=LEX
# Rótulo do operador (advogado que conversa com o LEX) nos prompts dos agentes
LEX_OPERADOR_LABEL=
# Quantos proxies confiáveis gravam o x-forwarded-for (Render = 1; sem proxy = 0)
LEX_TRUSTED_PROXY_HOPS=1

# Bom dia do LEX no WhatsApp do titular (LEX_OPERATOR_WHATSAPP): resumo diário
# de prazos, DJEN e pendências. 0 desliga; hora de Brasília (padrão 7).
LEX_BOM_DIA=1
LEX_BOM_DIA_HORA=7

# PJe via MNI 2.2.2 (webservice oficial do CNJ). Lista expedientes pendentes
# sem dar ciência; abrir teor só com "CONFIRMO CIENCIA SIGLA ID" do advogado.
# Endereços por tribunal (HTTPS .jus.br), separados por ponto e vírgula.
# Confirme o endereço de produção do MNI no site do tribunal.
PJE_MNI_TRIBUNAIS=TJMG=https://pje.tjmg.jus.br/pje/intercomunicacao
# Tribunais em eproc (TRF2, TRF4, TRF6, TJRS, TJSC, TJTO) ficam fora do MNI do PJe;
# publicações deles chegam pelo DJEN. PJe legado de um deles só com PJE_MNI_LEGADO=TRF6.
# eproc via MNI institucional. No TRF6, a integração exige credenciamento
# prévio do sistema/órgão; o tribunal fornece usuário e senha próprios.
# NÃO use CPF/OAB/senha pessoal do advogado como credencial MNI.
# PJE_MNI_EPROC=TRF6=https://<endpoint fornecido/homologado pelo TRF6>
PJE_MNI_EPROC=
PJE_MNI_EPROC_USUARIO=
PJE_MNI_EPROC_SENHA=
# O TRF6 informa MNI 2.2.3. Preencha os namespaces exatamente como no WSDL
# fornecido/homologado pelo tribunal; o LEX não adivinha esses valores.
PJE_MNI_EPROC_NS_SERVICO=
PJE_MNI_EPROC_NS_TIPOS=
PJE_MNI_CPF=
PJE_MNI_SENHA=
# Certificado A1 (.pfx em base64) só se o tribunal exigir TLS mútuo:
PJE_MNI_PFX_BASE64=
PJE_MNI_PFX_SENHA=

# Modo comercial (vários escritórios no mesmo banco). Ver docs/SAAS_ISOLAMENTO.md.
# Com LEX_COMERCIAL=1 o LEX só liga com escritório, tenancy obrigatória e
# PostgreSQL com a role lex_runtime (RLS). Gere com scripts/provision-office.js.
LEX_COMERCIAL=0
