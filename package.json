{
  "name": "lex-bot",
  "version": "1.0.0",
  "main": "bot.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bot.js",
    "dev": "node --watch bot.js",
    "check": "node scripts/check-syntax.js && npm run lint",
    "status:integracoes": "node scripts/check-integrations.js",
    "lint": "eslint lib/office-pipeline.js lib/office-command.js lib/office-queries.js lib/pje-mni.js lib/pje-monitor.js lib/datajud.js office-ui-v2.js office-flow-ui.js office-command-ui.js reception-handoff-ui.js login-theme.js office-attachment-ui.js office-dossier-ui.js lex-nav.js",
    "eval:core": "node --test test/core-natural-orders-eval.test.js",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.1",
    "nodemailer": "10.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
