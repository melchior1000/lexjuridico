{
  "name": "lex-bot",
  "version": "1.0.0",
  "main": "bot.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bot.js",
    "dev": "node --watch bot.js",
    "check": "node scripts/check-syntax.js && npm run lint",
    "status:integracoes": "node scripts/check-integrations.js",
    "lint": "eslint --no-warn-ignored lib/ scripts/ test/ *.js",
    "eval:core": "node --test test/core-natural-orders-eval.test.js",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.1",
    "nodemailer": "10.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
